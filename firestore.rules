rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users can read and write to their own user document, admins can read, write and delete any
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId || isAdmin();
      allow delete: if isAdmin(); // Admins can delete any user
      allow list: if isAdmin();
    }

    // Rules for the 'schedules' collection
    match /schedules/{date} {
      // Any authenticated user can read the main schedule document for a given date.
      allow read: if request.auth != null;
      
      // Allow authenticated users to create the schedule document (and subcollections)
      // This is necessary for the 'Create Default Schedule' button.
      allow create: if request.auth != null;

      // Rules for the 'slots' subcollection within each schedule
      match /slots/{slotId} {
        // Any authenticated user can read class slots.
        allow read: if request.auth != null;

        // Allow authenticated users to create and update slots.
        // 'create' is for the 'Create Default Schedule' functionality.
        // 'update' is for booking/unbooking classes.
        allow write: if request.auth != null;
      }
    }

    // Classes can be read by any authenticated user, but only written by admins
    match /classes/{classId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
